{
  "name": "driver-pay-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Static mobile-first PWA for driver income and work-time tracking",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:today": "TZ=Asia/Taipei node --test tests/work-time.test.js tests/today-follow-up.test.js tests/expense-calendar-kpi-integration.test.js",
    "test:ai": "TZ=Asia/Taipei node --test tests/ai.test.js tests/reading-size.test.js",
    "test:driver": "TZ=Asia/Taipei node --test tests/driver.test.js tests/reading-size.test.js",
    "test:integration": "TZ=Asia/Taipei node --test tests/integration.test.js tests/v1-regression.test.js",
    "test:calendar": "TZ=Asia/Taipei node --test tests/calendar.test.js tests/calendar-regression.test.js tests/navigation.test.js tests/expense-calendar-kpi-integration.test.js",
    "test:reports": "TZ=Asia/Taipei node --test tests/reporting.test.js tests/reports-core.test.js tests/reports-platform.test.js tests/reports-final-regression.test.js tests/reports-spec.test.js tests/reading-size.test.js tests/expense-calendar-kpi-integration.test.js",
    "lint": "node scripts/lint.mjs",
    "check:inline": "node scripts/check-inline.mjs",
    "check:sw": "node --check sw.js",
    "check:manifest": "node scripts/check-manifest.mjs",
    "validate:production": "node scripts/validate-production.mjs",
    "build": "npm run validate:production",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "parse5": "8.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
